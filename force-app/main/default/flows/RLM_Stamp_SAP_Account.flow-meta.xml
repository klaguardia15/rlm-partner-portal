<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Needs_Stamp</name>
        <label>Needs Stamp</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Already stamped</defaultConnectorLabel>
        <rules>
            <name>Account_Differs</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RLM_Account__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RLM_Account__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.SalesAgreement.AccountId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Stamp_Account</targetReference>
            </connector>
            <label>Account differs</label>
        </rules>
    </decisions>
    <description>Stamps Sales Agreement Product.Account from the parent agreement so Account can show contracted prices.</description>
    <environments>Default</environments>
    <interviewLabel>Stamp SAP Account {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Stamp SAP Account</label>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Stamp_Account</name>
        <label>Stamp Account</label>
        <locationX>176</locationX>
        <locationY>479</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>RLM_Account__c</field>
            <value>
                <elementReference>$Record.SalesAgreement.AccountId</elementReference>
            </value>
        </inputAssignments>
        <object>SalesAgreementProduct</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Needs_Stamp</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SalesAgreementId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>SalesAgreementProduct</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
